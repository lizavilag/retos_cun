# @title 📊 SIMULADOR EN VIVO: Impacto de Costos por Proveedor
# @description Ajusta las variables para evaluar la rentabilidad de la empresa.

import matplotlib.pyplot as plt

# --- CONTROLES INTERACTIVOS PARA EL ESTUDIANTE ---
costo_base_materia_prima = 100 #@param {type:"number"}
aumento_proveedor_pct = 35 #@param {type:"slider", min:0, max:60, step:5}
ajuste_precio_venta_pct = 15 #@param {type:"slider", min:0, max:40, step:1}

# --- CÁLCULOS AUTOMÁTICOS ---
nuevo_costo = costo_base_materia_prima * (1 + aumento_proveedor_pct / 100)
precio_venta_original = 150
nuevo_precio_venta = precio_venta_original * (1 + ajuste_precio_venta_pct / 100)
margen_ganancia = ((nuevo_precio_venta - nuevo_costo) / nuevo_precio_venta) * 100

# --- RESULTADOS FINANCIEROS ---
print("=" * 55)
print(f"📦 Nuevo Costo Materia Prima: ${nuevo_costo:.2f}")
print(f"🏷️ Nuevo Precio de Venta:     ${nuevo_precio_venta:.2f}")
print(f"📈 Margen de Ganancia Resultante: {margen_ganancia:.1f}%")
print("=" * 55)

# --- GRÁFICO IMPACTO DE RENTABILIDAD ---
fig, ax = plt.subplots(figsize=(6, 4))
color_barra = '#00A859' if margen_ganancia >= 20 else '#E63946'

ax.bar(['Margen Resultante (%)'], [margen_ganancia], color=color_barra, width=0.4)
ax.axhline(20, color='gray', linestyle='--', label='Margen Mínimo Deseado (20%)')
ax.set_ylim(0, 50)
ax.set_ylabel('Porcentaje (%)')
ax.set_title('Evaluación de Impacto Financiero')
ax.legend()
plt.grid(axis='y', linestyle=':', alpha=0.6)
plt.show()
